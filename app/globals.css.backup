@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --bg: #fdfcfa;
  --bg-alt: #ffffff;
  --ink: #16181d;
  --navy: #22262e;
  --slate: #6b7078;
  --accent: #b8722e;
  --line: #e7e4dd;
  --line-strong: #d8d4cb;
  --radius: 2px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-plex-sans), sans-serif;
  overflow-x: hidden;
}

::selection {
  background: var(--ink);
  color: var(--bg);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* =========================
   TYPOGRAPHY
========================= */

h1,
h2,
h3,
p {
  margin: 0;
}

h1,
h2,
h3 {
  font-family: var(--font-fraunces), serif;
  font-weight: 500;
  letter-spacing: -0.025em;
}

h1 {
  font-size: clamp(3.5rem, 8vw, 7.5rem);
  line-height: 0.95;
}

h2 {
  max-width: 850px;
  font-size: clamp(2.2rem, 5vw, 4.5rem);
  line-height: 1;
}

h3 {
  font-size: 1.35rem;
  line-height: 1.15;
}

/* =========================
   SITE SHELL
========================= */

.site-shell {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
}

.site-section {
  padding: 120px 0;
  border-top: 1px solid var(--line);
}

.section-heading {
  margin-bottom: 64px;
}

.eyebrow {
  margin-bottom: 18px;
  color: var(--accent);
  font-family: var(--font-plex-sans), sans-serif;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  line-height: 1;
  text-transform: uppercase;
}

/* =========================
   NAVIGATION
========================= */

.site-header {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28px 0;
  border-bottom: 1px solid var(--line);
}

.brand {
  font-family: var(--font-fraunces), serif;
  font-size: 1.25rem;
  font-weight: 500;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  color: var(--slate);
  font-size: 0.875rem;
}

.nav-links a {
  transition: color 180ms ease;
}

.nav-links a:hover {
  color: var(--ink);
}

/* =========================
   HERO
========================= */

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 100px 0 80px;
}

.hero-copy {
  max-width: 950px;
}

.hero h1 {
  max-width: 900px;
}

.hero-description {
  max-width: 650px;
  margin-top: 36px;
  color: var(--slate);
  font-size: clamp(1.05rem, 2vw, 1.25rem);
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 42px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 22px;
  border: 1px solid var(--ink);
  border-radius: var(--radius);
  font-size: 0.9rem;
  font-weight: 600;
  transition:
    background 180ms ease,
    color 180ms ease,
    border-color 180ms ease;
}

.button-primary {
  background: var(--ink);
  color: var(--bg);
}

.button-primary:hover {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

.button-secondary {
  border-color: var(--line-strong);
  color: var(--ink);
}

.button-secondary:hover {
  border-color: var(--ink);
}

.hero-note {
  margin-top: auto;
  padding-top: 60px;
  color: var(--slate);
  font-size: 0.8rem;
  letter-spacing: 0.03em;
}

/* =========================
   SERVICES
========================= */

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.service-item {
  min-height: 260px;
  padding: 32px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.service-number,
.proof-number {
  display: block;
  margin-bottom: 48px;
  color: var(--accent);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.service-item p,
.proof-item p {
  max-width: 480px;
  margin-top: 14px;
  color: var(--slate);
  line-height: 1.7;
}

/* =========================
   PROOF
========================= */

.proof-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.proof-item {
  min-height: 240px;
  padding: 32px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

/* =========================
   PROCESS
========================= */

.process-list {
  border-top: 1px solid var(--line);
}

.process-step {
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 30px;
  padding: 32px 0;
  border-bottom: 1px solid var(--line);
}

.process-step > span {
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.process-step p {
  max-width: 650px;
  margin-top: 10px;
  color: var(--slate);
  line-height: 1.7;
}

/* =========================
   CONTACT
========================= */

.contact-panel {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 60px;
  align-items: end;
  padding: 48px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.contact-copy {
  max-width: 620px;
}

.contact-copy p {
  color: var(--slate);
  font-size: 1.05rem;
  line-height: 1.7;
}

.contact-copy p + p {
  margin-top: 16px;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
}

.contact-link {
  color: var(--slate);
  font-size: 0.9rem;
}

.contact-link:hover {
  color: var(--ink);
}

/* =========================
   FOOTER
========================= */

.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 32px 0 48px;
  color: var(--slate);
  font-size: 0.8rem;
}

.footer-links {
  display: flex;
  gap: 20px;
}

.footer-links a:hover {
  color: var(--ink);
}

/* =========================
   PROJECTS
========================= */

.project-list {
  border-top: 1px solid var(--line);
}

.project {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 40px;
  padding: 48px 0;
  border-bottom: 1px solid var(--line);
}

.project-meta {
  display: flex;
  flex-direction: column;
  gap: 12px;
  color: var(--accent);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.project-meta span:last-child {
  color: var(--slate);
  font-weight: 400;
  letter-spacing: 0;
  line-height: 1.5;
}

.project-main {
  max-width: 760px;
}

.project-main h3 {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
}

.project-description {
  margin-top: 18px;
  color: var(--ink);
  font-size: 1.05rem;
  line-height: 1.65;
}

.project-detail {
  margin-top: 16px;
  color: var(--slate);
  line-height: 1.7;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}

.project-tags span {
  padding: 7px 10px;
  border: 1px solid var(--line);
  color: var(--slate);
  font-size: 0.72rem;
}

.project-links {
  display: flex;
  gap: 24px;
  margin-top: 28px;
  font-size: 0.85rem;
  font-weight: 600;
}

.project-links a:hover {
  color: var(--accent);
}

@media (max-width: 800px) {
  .project {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .project-meta {
    flex-direction: row;
    justify-content: space-between;
  }
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 800px) {
  .site-shell {
    width: min(100% - 32px, 680px);
  }

  .nav {
    padding: 22px 0;
  }

  .nav-links {
    gap: 16px;
  }

  .nav-links a:nth-child(2) {
    display: none;
  }

  .hero {
    padding: 80px 0 60px;
  }

  .site-section {
    padding: 88px 0;
  }

  .section-heading {
    margin-bottom: 42px;
  }

  .service-grid,
  .proof-grid {
    grid-template-columns: 1fr;
  }

  .contact-panel {
    grid-template-columns: 1fr;
    align-items: start;
  }
}

@media (max-width: 560px) {
  .site-shell {
    width: calc(100% - 28px);
  }

  .nav {
    align-items: flex-start;
  }

  .brand {
    font-size: 1.1rem;
  }

  .nav-links {
    gap: 12px;
    font-size: 0.75rem;
  }

  .nav-links a:nth-child(3) {
    display: none;
  }

  .hero {
    min-height: auto;
    padding: 70px 0 50px;
  }

  h1 {
    font-size: clamp(3.2rem, 16vw, 5rem);
  }

  h2 {
    font-size: clamp(2.2rem, 11vw, 3.5rem);
  }

  .hero-description {
    margin-top: 28px;
    font-size: 1rem;
  }

  .hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .button {
    width: 100%;
  }

  .service-item,
  .proof-item {
    min-height: auto;
    padding: 26px;
  }

  .service-number,
  .proof-number {
    margin-bottom: 36px;
  }

  .process-step {
    grid-template-columns: 48px 1fr;
    gap: 16px;
  }

  .site-footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
/* =========================
   BLOG / EDITORIAL
========================= */

/* =========================
   BLOG HOMEPAGE
========================= */

.blog-shell .blog-hero {
  padding-top: 112px;
  padding-bottom: 112px;
}

.blog-shell .blog-hero-copy {
  max-width: 900px;
}

.blog-shell .blog-page-title {
  margin-top: 24px;
  color: var(--blog-ink);
  font-family: var(--font-fraunces), Georgia, serif;
  font-size: clamp(3.5rem, 8vw, 7rem);
  font-weight: 600;
  line-height: 0.98;
  letter-spacing: -0.035em;
}

.blog-shell .blog-page-title span {
  color: var(--blog-blue-deep);
}

.blog-shell .blog-hero-description {
  max-width: 680px;
  margin-top: 32px;
  color: var(--blog-ink-muted);
  font-family: var(--font-plex-sans), sans-serif;
  font-size: 1.15rem;
  line-height: 1.8;
}

.blog-shell .blog-featured {
  padding-bottom: 112px;
}

.blog-shell .blog-section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16px;
  margin-bottom: 16px;
}

.blog-shell .blog-index {
  color: var(--blog-ink-faint);
  font-size: 0.7rem;
}

.blog-shell .blog-writing {
  padding-bottom: 112px;
}

.blog-shell .blog-empty {
  padding: 48px 0;
  border-top: 1px solid var(--blog-line);
  border-bottom: 1px solid var(--blog-line);
  color: var(--blog-ink-muted);
  font-size: 0.8rem;
}

.blog-shell .blog-about {
  border-top: 1px solid var(--blog-line);
  border-bottom: 1px solid var(--blog-line);
  background: var(--blog-blue-soft);
}

.blog-shell .blog-about-grid {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 40px;
  padding: 80px 0;
}

.blog-shell .blog-about-copy {
  max-width: 680px;
}

.blog-shell .blog-about-copy h2 {
  color: var(--blog-ink);
  font-family: var(--font-fraunces), Georgia, serif;
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.025em;
}

.blog-shell .blog-about-copy p {
  margin-top: 24px;
  color: var(--blog-ink-muted);
  font-size: 1rem;
  line-height: 1.8;
}

.blog-shell .blog-about-copy a {
  display: inline-block;
  margin-top: 28px;
  color: var(--blog-blue-deep);
  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

@media (max-width: 768px) {
  .blog-shell .blog-hero {
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .blog-shell .blog-page-title {
    font-size: clamp(3rem, 13vw, 5.5rem);
  }

  .blog-shell .blog-hero-description {
    font-size: 1rem;
    line-height: 1.75;
  }

  .blog-shell .blog-featured,
  .blog-shell .blog-writing {
    padding-bottom: 80px;
  }

  .blog-shell .blog-about-grid {
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 64px 0;
  }
}

.blog-shell {
  --blog-paper: #f7f9fc;
  --blog-surface: #ffffff;
  --blog-ink: #17202a;
  --blog-ink-soft: #42505d;
  --blog-ink-muted: #687683;
  --blog-ink-faint: #8d9aa5;
  --blog-blue: #6ea8d7;
  --blog-blue-deep: #315f86;
  --blog-blue-soft: #e8f2fa;
  --blog-line: #dce5ec;
  --blog-line-strong: #c8d5df;
  background: var(--blog-paper);
  color: var(--blog-ink);
  min-height: 100vh;
  font-family: var(--font-plex-sans), sans-serif;
    --paper: var(--blog-paper);
  --surface: var(--blog-surface);
  --ink: var(--blog-ink);
  --ink-soft: var(--blog-ink-soft);
  --ink-muted: var(--blog-ink-muted);
  --ink-faint: var(--blog-ink-faint);
  --blue: var(--blog-blue);
  --blue-deep: var(--blog-blue-deep);
  --blue-soft: var(--blog-blue-soft);
  --line: var(--blog-line);
  --line-strong: var(--blog-line-strong);
}

.blog-shell .blog-container {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

.blog-shell .eyebrow {
  margin-bottom: 0;
  color: var(--blog-blue-deep);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.7rem;
  font-weight: 400;
  letter-spacing: 0.16em;
  line-height: 1;
  text-transform: uppercase;
}

.blog-shell .font-display {
  font-family: var(--font-fraunces), Georgia, serif;
}

.blog-shell .font-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.blog-shell .editorial-rule {
  width: 100%;
  height: 1px;
  background: var(--blog-line);
}

.blog-shell .post-link {
  position: relative;
}

.blog-shell .post-link::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -3px;
  width: 100%;
  height: 1px;
  background: var(--blog-blue);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 180ms ease;
}

.blog-shell .post-link:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.blog-shell .article-body {
  color: var(--blog-ink-soft);
  font-size: 1.125rem;
  line-height: 1.85;
}

.blog-shell .article-body h2,
.blog-shell .article-body h3,
.blog-shell .article-body h4 {
  color: var(--blog-ink);
  font-family: var(--font-fraunces), Georgia, serif;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.blog-shell .article-body h2 {
  margin-top: 4rem;
  margin-bottom: 1.25rem;
  font-size: 2.25rem;
}

.blog-shell .article-body h3 {
  margin-top: 3rem;
  margin-bottom: 1rem;
  font-size: 1.7rem;
}

.blog-shell .article-body h4 {
  margin-top: 2.5rem;
  margin-bottom: 0.75rem;
  font-size: 1.3rem;
}

.blog-shell .article-body p {
  margin: 0 0 1.6rem;
}

.blog-shell .article-body strong {
  color: var(--blog-ink);
  font-weight: 600;
}

.blog-shell .article-body a {
  color: var(--blog-blue-deep);
  text-decoration: underline;
  text-decoration-color: var(--blog-blue);
  text-decoration-thickness: 1px;
  text-underline-offset: 4px;
}

.blog-shell .article-body a:hover {
  text-decoration-color: var(--blog-blue-deep);
}

.blog-shell .article-body ul,
.blog-shell .article-body ol {
  margin: 0 0 1.6rem;
  padding-left: 1.5rem;
}

.blog-shell .article-body li {
  margin-bottom: 0.55rem;
  padding-left: 0.25rem;
}

.blog-shell .article-body blockquote {
  margin: 2.5rem 0;
  padding: 1.25rem 1.5rem;
  border-left: 3px solid var(--blog-blue);
  background: var(--blog-blue-soft);
  color: var(--blog-ink);
}

.blog-shell .article-body hr {
  margin: 3rem 0;
  border: 0;
  border-top: 1px solid var(--blog-line);
}

.blog-shell .article-body pre {
  overflow-x: auto;
  margin: 2.5rem -1rem;
  padding: 1.5rem;
  background: #17202a;
  color: #eaf1f6;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.82rem;
  line-height: 1.75;
  border-radius: 2px;
}

.blog-shell .article-body code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.88em;
}

.blog-shell .article-body :not(pre) > code {
  padding: 0.15rem 0.35rem;
  background: var(--blog-blue-soft);
  color: var(--blog-blue-deep);
}

.blog-shell .article-body img {
  display: block;
  width: 100%;
  height: auto;
  margin: 2.5rem 0;
}

.blog-shell .article-body figure {
  margin: 2.5rem 0;
}

.blog-shell .article-body figcaption {
  margin-top: 0.75rem;
  color: var(--blog-ink-faint);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 0.68rem;
  line-height: 1.5;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

@media (max-width: 768px) {
  .blog-shell .site-container {
    width: min(100% - 32px, 680px);
  }

  .blog-shell .article-body {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .blog-shell .article-body h2 {
    margin-top: 3rem;
    font-size: 1.9rem;
  }

  .blog-shell .article-body h3 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
  }

  .blog-shell .article-body pre {
    margin-inline: -1rem;
    padding-inline: 1rem;
    border-radius: 0;
    font-size: 0.78rem;
  }
}
